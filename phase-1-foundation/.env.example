# E-Commerce Platform - Environment Configuration
# Copy this file to .env and update values for your environment

# ========== APPLICATION ==========
ENVIRONMENT=development
ENVIRONMENT_DEVELOPMENT_GATEWAY_TIMEOUT=30
LOG_LEVEL=debug

# ========== DATABASE ==========
# User Service Database
DATABASE_URL_USER=postgres://postgres:postgres@postgres-user:5432/user_db?sslmode=disable
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST_USER=postgres-user
DATABASE_PORT=5432
DATABASE_NAME_USER=user_db

# Product Service Database
DATABASE_URL_PRODUCT=postgres://postgres:postgres@postgres-product:5432/product_db?sslmode=disable
DATABASE_HOST_PRODUCT=postgres-product
DATABASE_PORT=5434
DATABASE_NAME_PRODUCT=product_db

# Cart Service Database
DATABASE_URL_CART=postgres://postgres:postgres@postgres-cart:5432/cart_db?sslmode=disable
DATABASE_HOST_CART=postgres-cart
DATABASE_PORT=5435
DATABASE_NAME_CART=cart_db

# Order Service Database
DATABASE_URL_ORDER=postgres://postgres:postgres@postgres-order:5432/order_db?sslmode=disable
DATABASE_HOST_ORDER=postgres-order
DATABASE_PORT=5436
DATABASE_NAME_ORDER=order_db

# ========== REDIS ==========
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== KAFKA ==========
KAFKA_BROKERS=kafka-broker-1:9092,kafka-broker-2:9092,kafka-broker-3:9092
KAFKA_SCHEMA_REGISTRY_URL=http://kafka-schema-registry:8081
KAFKA_CONSUMER_GROUP=ecommerce-service
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ========== JWT ==========
JWT_SECRET=your-super-secret-key-min-32-characters-long-123456
JWT_ISSUER=EcommerceAPI
JWT_AUDIENCE=EcommerceClient
JWT_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ========== STRIPE (PAYMENT) ==========
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ========== SERVICE PORTS ==========
USER_SERVICE_PORT=5001
PRODUCT_SERVICE_PORT=5002
CART_SERVICE_PORT=5003
ORDER_SERVICE_PORT=5004
PAYMENT_SERVICE_PORT=5005
NOTIFICATION_SERVICE_PORT=5006
API_GATEWAY_PORT=8080

# ========== MONITORING ==========
# Jaeger
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# ========== ELASTICSEARCH (Optional - for search) ==========
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ========== SENDGRID (Email notifications) ==========
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ecommerce-platform.com
SENDGRID_SENDER_NAME=E-Commerce Platform

# ========== CORS ==========
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# ========== RATE LIMITING ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ========== CACHE ==========
CACHE_TTL_PRODUCT_SECONDS=600
CACHE_TTL_CATEGORY_SECONDS=3600
CACHE_TTL_USER_SECONDS=1800
CACHE_TTL_CART_SECONDS=3600

# ========== FEATURE FLAGS ==========
FEATURE_ELASTICSEARCH_ENABLED=true
FEATURE_CACHE_ENABLED=true
FEATURE_SAGA_PATTERN_ENABLED=true
FEATURE_EVENT_SOURCING_ENABLED=false

# ========== MAINTENANCE ==========
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.
